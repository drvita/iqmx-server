# Configuración de Servidor de Webhooks (FastAPI)
# ----------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Inteligencia Artificial (Gemini API)
# ----------------------------------------------------
# [REQUERIDO] API Key de Gemini para el agente Octavio.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_TEMPERATURE=0.2

# Integraciones de Mensajería (Telegram y WhatsApp)
# ----------------------------------------------------
# [OPCIONAL] Token del bot de Telegram si se usa dicho canal.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# [REQUERIDO para agente administrativo] Lista separada por comas de IDs de Telegram autorizados (ej: 12345,67890)
ADMIN_TELEGRAM_IDS=your_allowed_telegram_ids_here

# [REQUERIDO] Credenciales de YCloud para envío de mensajes a WhatsApp.
YCLOUD_API_KEY=your_ycloud_api_key_here
# [REQUERIDO] Número de teléfono del bot en formato E.164 (ej: +523141560219).
YCLOUD_FROM_PHONE=your_ycloud_whatsapp_from_phone_number_here
# [REQUERIDO en prod, OPCIONAL en dev] Firma para validar eventos entrantes.
YCLOUD_WEBHOOK_SECRET=your_ycloud_webhook_secret_here

# Base de Datos y Persistencia (LangGraph / Sesiones)
# ----------------------------------------------------
# Tipo de base de datos a utilizar (sqlite | postgresql).
DATABASE_TYPE=postgresql

# [REQUERIDO en prod] Configuración si DATABASE_TYPE=postgresql.
# Nota: En desarrollo local fuera de Docker usar "localhost:5432", en Docker usar "db:5432".
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/iqmx_test

# Microservicio API Central
# ----------------------------------------------------
# URL base de la API central para registro de usuarios y partners.
# Nota: En desarrollo local fuera de Docker usar "http://localhost:8001/api", en Docker usar "http://api:8000/api".
API_URL=http://localhost:8001/api
