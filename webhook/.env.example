# Configuración general
# ----------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Seguridad y CORS
# ----------------------------------------------------
# En desarrollo se permite "*". En producción, listar los orígenes permitidos separados por comas.
# Ejemplo: ALLOWED_ORIGINS=https://mi-frontend.com,https://app.mi-frontend.com
ALLOWED_ORIGINS=*

# Limitación de peticiones (Rate Limit)
# ----------------------------------------------------
# Número máximo de peticiones permitidas por segundo por dirección IP
RATE_LIMIT_PER_SECOND=35

# Configuración del Webhook de WhatsApp
# ----------------------------------------------------
# [REQUERIDO] Token secreto de verificación para Meta (Handshake GET).
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

# [REQUERIDO en prod, OPCIONAL en dev] Clave secreta de la aplicación de Meta (App Secret) para validar firmas.
META_APP_SECRET=your_meta_app_secret_here

# Microservicio API Central
# ----------------------------------------------------
# [REQUERIDO] URL base de la API central.
# Nota: En desarrollo local fuera de Docker usar "http://localhost:8001", en Docker usar "http://api:8000".
API_URL=http://localhost:8001
