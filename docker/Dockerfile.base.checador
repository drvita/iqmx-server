# ==============================================================================
# IQISSMexico - Checador Base Image
# Pre-installed Node.js 22 + npm dependencies for Checador Facial
# ==============================================================================
FROM node:22-alpine

# Install build dependencies for native node modules
RUN apk add --no-cache libc6-compat python3 make g++

WORKDIR /app

# Copy package descriptors from checador directory
COPY checador/package.json checador/package-lock.json* ./

# Install all production and dev dependencies cleanly
RUN npm ci --prefer-offline --no-audit

CMD ["node"]
