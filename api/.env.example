# Configuración General (FastAPI)
# ----------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Base de Datos (opciones: sqlite | postgresql)
# ----------------------------------------------------
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./whatsapp_events.db

# Credenciales requeridas únicamente si DATABASE_TYPE=postgresql
# ----------------------------------------------------
# Nota: En desarrollo local fuera de Docker usar "localhost", en Docker usar "db".
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=iqmx_test

# Meta Graph API & Webhook Dispatcher
# ----------------------------------------------------
WHATSAPP_VERIFY_TOKEN=iqmx_webhook_verify_token_default
META_APP_ID=1560064249064360
META_APP_SECRET=your_meta_app_secret_here
META_CONFIG_ID=968187492720390
GRAPH_API_VERSION=v25.0
RATE_LIMIT_PER_SECOND=35
WA_CRM_NUMBER=tu_numero_del_crm

# Cifrado en Reposo de Tokens de WhatsApp (AES-256-GCM)
# ----------------------------------------------------
TOKEN_ENCRYPTION_KEY=super_secure_token_encryption_key_32_bytes_long_iqmx

# Autenticación JWT Portal de Clientes
# ----------------------------------------------------
JWT_SECRET_KEY=portal_jwt_secret_key_change_in_production_iqmx_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Motor de Prospección Inteligente (DENUE INEGI)
# ----------------------------------------------------
DENUE_API_TOKEN=your_inegi_denue_token_here
DENUE_API_BASE_URL=https://www.inegi.org.mx/app/api/denue/v1/consulta/

# Evaluador LLM de Prospección (LangChain / OpenRouter)
# ----------------------------------------------------
LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_TEMPERATURE=0.1

# Plantilla Mailtrap para Prospección por Correo
# ----------------------------------------------------
MAILTRAP_TEMPLATE_PROSPECTING=0d146921-fad6-4e2b-98cb-debdde390655
MAILTRAP_WEBHOOK_SECRET=secret_key
