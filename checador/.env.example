# ============================================================
# IQISSMexico Checador Facial SaaS — Variables de entorno
# ============================================================

# Puerto interno del servidor Next.js (expuesto en 3002 via docker-compose)
PORT=3000
HOSTNAME=0.0.0.0
APP_BASE_URL=http://localhost:3002

# Base de datos PostgreSQL (schema dedicado: checador)
DATABASE_URL=postgresql://postgres:REEMPLAZA_password_de_postgres@db:5432/iqmx_test?options=-csearch_path%3Dchecador,public

# Redis (tokens efímeros, rate limit y blacklist de dispositivos)
REDIS_URL=redis://redis:6379

# Clave secreta M2M para aprovisionamiento desde el portal central (api/)
PROVISION_SECRET_KEY=REEMPLAZA_clave_m2m_provision
